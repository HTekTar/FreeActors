{
  "name": "freeactors-hsm-editor",
  "publisher": "HTekTar",
  "version": "0.0.1",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cp -r freeactors_lib out/",
    "watch": "tsc -watch -p ./"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:freeactors.hsmEditor"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "freeactors.hsmEditor",
        "displayName": "FreeActors HSM",
        "selector": [
          {
            "filenamePattern": "*.hsm.json"
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^4.9.4 "
  }
}
